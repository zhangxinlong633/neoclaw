{
  "model": {
    "base_url": "http://127.0.0.1:9",
    "name": "test",
    "api_key": "x"
  },
  "tools": {
    "enabled": true,
    "root": ".",
    "commands": [
      {
        "name": "echo_args",
        "description": "Echo",
        "argv": ["./scripts/tools/echo-args.sh"],
        "timeout_sec": 5,
        "max_output_bytes": 4096,
        "pass_args": "stdin_json"
      }
    ]
  },
  "workflows": [
    {
      "name": "llm_tools_off",
      "steps": [
        {
          "id": "echo",
          "type": "tool",
          "tool": "echo_args",
          "args": {}
        },
        {
          "id": "summarize",
          "type": "llm",
          "depends_on": ["echo"],
          "tools": "off",
          "prompt": "Say hi about {{steps.echo}}"
        }
      ]
    }
  ]
}
