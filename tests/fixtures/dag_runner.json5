{
  "model": {
    "base_url": "http://127.0.0.1:9",
    "name": "test",
    "api_key": "x"
  },
  "capability_matrix": {
    "enabled": true,
    "root": ".",
    "commands": [
      {
        "name": "count_run",
        "description": "Append one line to tests/fixtures/count.out",
        "argv": ["./tests/fixtures/bin/count.sh"],
        "timeout_sec": 5,
        "max_output_bytes": 4096,
        "pass_args": "stdin_json"
      },
      {
        "name": "flaky_count",
        "description": "Fails once then appends to count.out",
        "argv": ["./tests/fixtures/bin/flaky_count.sh"],
        "timeout_sec": 5,
        "max_output_bytes": 4096,
        "pass_args": "stdin_json"
      }
    ]
  },
  "dags": [
    {
      "name": "diamond",
      "description": "A -> B,C -> D",
      "steps": [
        { "id": "a", "type": "tool", "tool": "count_run", "args": {} },
        { "id": "b", "type": "tool", "tool": "count_run", "depends_on": ["a"], "args": {} },
        { "id": "c", "type": "tool", "tool": "count_run", "depends_on": ["a"], "args": {} },
        { "id": "d", "type": "tool", "tool": "count_run", "depends_on": ["b", "c"], "args": {} }
      ]
    },
    {
      "name": "route_demo",
      "steps": [
        { "id": "seed", "type": "tool", "tool": "count_run", "args": {} },
        {
          "id": "branch",
          "type": "route",
          "depends_on": ["seed"],
          "on": "pdf document",
          "match": "pdf",
          "then": ["take_then"],
          "else": ["take_else"]
        },
        { "id": "take_then", "type": "tool", "tool": "count_run", "depends_on": ["branch"], "args": {} },
        { "id": "take_else", "type": "tool", "tool": "count_run", "depends_on": ["branch"], "args": {} }
      ]
    },
    {
      "name": "route_merge",
      "description": "join after route must run when one branch is skipped",
      "steps": [
        { "id": "seed", "type": "tool", "tool": "count_run", "args": {} },
        {
          "id": "branch",
          "type": "route",
          "depends_on": ["seed"],
          "on": "pdf document",
          "match": "pdf",
          "then": [],
          "else": ["fix_branch"]
        },
        { "id": "fix_branch", "type": "tool", "tool": "count_run", "depends_on": ["branch"], "args": {} },
        { "id": "join", "type": "tool", "tool": "count_run", "depends_on": ["branch", "fix_branch"], "args": {} }
      ]
    },
    {
      "name": "route_cases",
      "description": "multi-way cases: docx arm runs",
      "steps": [
        { "id": "seed", "type": "tool", "tool": "count_run", "args": {} },
        {
          "id": "branch",
          "type": "route",
          "depends_on": ["seed"],
          "on": "choose docx file",
          "cases": [
            { "match": "pdf", "then": ["take_pdf"] },
            { "match": "docx", "then": ["take_docx"] },
            { "then": ["take_other"] }
          ]
        },
        { "id": "take_pdf", "type": "tool", "tool": "count_run", "depends_on": ["branch"], "args": {} },
        { "id": "take_docx", "type": "tool", "tool": "count_run", "depends_on": ["branch"], "args": {} },
        { "id": "take_other", "type": "tool", "tool": "count_run", "depends_on": ["branch"], "args": {} }
      ]
    },
    {
      "name": "tool_retry",
      "description": "flaky tool succeeds on retry",
      "steps": [
        {
          "id": "flaky",
          "type": "tool",
          "tool": "flaky_count",
          "retry": { "max": 1 },
          "args": {}
        }
      ]
    }
  ],
  "skills": { "directory": "skills" },
  "memory": { "path": "MEMORY.md", "max_chars": 100 },
  "session": { "max_turns": 2 }
}
