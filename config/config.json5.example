// Neo agent config example (JSON5 — comments & trailing commas OK).
// Copy to config/config.json5 and adjust.
// Env overrides: NEO_MODEL, NEO_API_KEY, NEO_CONFIG.

{
  model: {
    provider: "openrouter",
    base_url: "https://openrouter.ai/api/v1",
    name: "qwen/qwen3-32b",
    api_key: "YOUR_OPENROUTER_API_KEY",
    max_tokens: 4096,
    temperature: 0.7,
  },

  // soul: { path: "SOUL.md", max_chars: 8000 },

  bootstrap: {
    max_chars_per_file: 8000,
    paths: ["AGENTS.md"],
  },

  // rules: { max_chars_per_file: 6000, paths: ["RULES.md"] },
  // workspace: { prompt_cwd: true },

  skills: {
    directory: "skills",
    high_priority: ["nanjing"],
    unmatched: "index",
  },

  memory: {
    path: "MEMORY.md",
    max_chars: 4000,
  },

  session: {
    max_turns: 10,
  },

  // capability_matrix: {
  //   enabled: true,
  //   root: ".",
  //   directory: "capabilities", // one file per capability; see capabilities/manifest.json5
  //   max_rounds: 16,
  //   shell_enabled: false, // true → expose run_command (argv under root, no shell)
  //   // optional inline commands (merged with directory load[]):
  //   // commands: [ { name: "date_iso", argv: ["/bin/date", "-u", "+%Y-%m-%dT%H:%M:%SZ"] } ],
  //   // mcp_servers: [
  //   //   { name: "mock", command: "python3", args: ["tests/fixtures/mock_mcp_echo.py"] },
  //   // ],
  // },

  // workflow_directory: "dags", // one DAG per file; see dags/manifest.json5

  // plan: { target_steps: 10 },
}
