{
  model: {
    base_url: "http://127.0.0.1:9",
    name: "test",
    api_key: "x",
  },
  capability_matrix: {
    enabled: true,
    root: ".",
    commands: [
      {
        name: "echo_args",
        description: "Echo arguments JSON",
        argv: ["./scripts/tools/echo-args.sh"],
        timeout_sec: 5,
        max_output_bytes: 4096,
        pass_args: "stdin_json",
      },
      {
        name: "count_run",
        description: "Append to count.out",
        argv: ["./scripts/tools/count.sh"],
        timeout_sec: 5,
        max_output_bytes: 4096,
        pass_args: "stdin_json",
      },
    ],
  },
  dags: [
    {
      name: "demo_loop",
      description: "run count twice via loop",
      steps: [
        { id: "fetch", type: "tool", tool: "count_run", args: {} },
        { id: "again", type: "loop", over: ["fetch"], max: 2, until: "always" },
      ],
    },
  ],
  memory: { path: "MEMORY.md", max_chars: 200 },
  session: { max_turns: 4 },
}
