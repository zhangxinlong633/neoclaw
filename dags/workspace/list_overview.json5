{
  name: "list_overview",
  description: "List the workspace root directory then have an LLM describe the layout.",
  when: ["Need a quick orientation of top-level files and folders"],
  when_not: ["Deep recursive trees or single-file deep dive"],
  tags: ["fs", "llm"],
  requires: ["list_dir"],
  outcome: "Directory name list plus a short structural overview",
  steps: [
    {
      id: "ls",
      type: "tool",
      tool: "list_dir",
      args: { path: "." },
    },
    {
      id: "overview",
      type: "llm",
      tools: "off",
      prompt: "根据目录列表，用条目说明各顶层项大概职责（未知则标未知）。列表={{steps.ls}}",
      depends_on: ["ls"],
    },
  ],
}
