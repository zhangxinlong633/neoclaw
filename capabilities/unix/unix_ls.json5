{
  name: "unix_ls",
  description: "List directory entries.",
  when: ["Need directory listing"],
  when_not: ["Avoid -R on large trees"],
  tags: ["unix", "fs", "safeish"],
  outcome: "Usage: ls -la . | Sample: total 128",
  sample_usage: "ls -la .",
  sample_output: "total 128",
  argv: ["./scripts/tools/unix-exec.sh", "/bin/ls"],
  timeout_sec: 10,
  max_output_bytes: 65536,
  pass_args: "env",
  parameters: {"type": "object", "properties": {"argv": {"type": "array", "items": {"type": "string"}, "description": "Extra argv after the binary. Relative paths only; no ..; simple -x/--long flags."}}},
}
