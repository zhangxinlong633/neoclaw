{
  name: "unix_nproc",
  description: "Print number of available processing units.",
  when: ["Need CPU count"],
  when_not: ["May be missing on macOS"],
  tags: ["unix", "system", "safeish"],
  outcome: "Usage: nproc | Sample: 8",
  sample_usage: "nproc",
  sample_output: "8",
  argv: ["/usr/bin/nproc"],
  timeout_sec: 10,
  max_output_bytes: 65536,
  pass_args: "env",
  parameters: {"type": "object", "properties": {}},
}
