{
  name: "unix_echo",
  description: "Write arguments to stdout.",
  when: ["Need literal echo"],
  when_not: ["Not write_file"],
  tags: ["unix", "util", "safeish"],
  outcome: "Usage: echo hello | Sample: hello",
  sample_usage: "echo hello",
  sample_output: "hello",
  argv: ["./scripts/tools/unix-exec.sh", "/bin/echo"],
  timeout_sec: 10,
  max_output_bytes: 65536,
  pass_args: "env",
  parameters: {"type": "object", "properties": {"argv": {"type": "array", "items": {"type": "string"}, "description": "Extra argv after the binary. Relative paths only; no ..; simple -x/--long flags."}}},
}
