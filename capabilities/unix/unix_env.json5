{
  name: "unix_env",
  description: "Print the process environment.",
  when: ["Rare diagnostics"],
  when_not: ["Leaks secrets", "Not in default enabled.json5; enable only after Policy review"],
  tags: ["unix", "system", "dangerous"],
  outcome: "Usage: env | Sample: PATH=...",
  sample_usage: "env",
  sample_output: "PATH=...",
  argv: ["/usr/bin/env"],
  timeout_sec: 15,
  max_output_bytes: 32768,
  pass_args: "env",
  parameters: {"type": "object", "properties": {}},
}
