{
  name: "unix_du",
  description: "Estimate file space usage.",
  when: ["Need size of a tree/file"],
  when_not: ["Avoid deep trees"],
  tags: ["unix", "fs", "safeish"],
  outcome: "Usage: du -sh . | Sample: 12M .",
  sample_usage: "du -sh .",
  sample_output: "12M .",
  argv: ["./scripts/tools/unix-exec.sh", "/usr/bin/du"],
  timeout_sec: 10,
  max_output_bytes: 65536,
  pass_args: "env",
  parameters: {"type": "object", "properties": {"argv": {"type": "array", "items": {"type": "string"}, "description": "Extra argv after the binary. Relative paths only; no ..; simple -x/--long flags."}}},
}
