{
  name: "unix_gunzip",
  description: "gunzip decompress.",
  when: ["Need gunzip"],
  when_not: ["Mutates files", "Not in default enabled.json5; enable only after Policy review"],
  tags: ["unix", "archive", "dangerous"],
  outcome: "Usage: gunzip -c file.gz | Sample: ...",
  sample_usage: "gunzip -c file.gz",
  sample_output: "...",
  argv: ["./scripts/tools/unix-exec.sh", "/usr/bin/gunzip"],
  timeout_sec: 15,
  max_output_bytes: 32768,
  pass_args: "env",
  parameters: {"type": "object", "properties": {"argv": {"type": "array", "items": {"type": "string"}, "description": "Extra argv after the binary. Relative paths only; no ..; simple -x/--long flags."}}},
}
