{
  name: "unix_compress",
  description: "Legacy compress(1).",
  when: ["Rare legacy"],
  when_not: ["Keep disabled", "Not in default enabled.json5; enable only after Policy review"],
  tags: ["unix", "archive", "dangerous"],
  outcome: "Usage: compress -c file | Sample: ",
  sample_usage: "compress -c file",
  sample_output: "",
  argv: ["./scripts/tools/unix-exec.sh", "/usr/bin/compress"],
  timeout_sec: 15,
  max_output_bytes: 32768,
  pass_args: "env",
  parameters: {"type": "object", "properties": {"argv": {"type": "array", "items": {"type": "string"}, "description": "Extra argv after the binary. Relative paths only; no ..; simple -x/--long flags."}}},
}
