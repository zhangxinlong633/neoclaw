{
  name: "unix_mkdir_unix",
  description: "Create directories (prefer builtin mkdir).",
  when: ["Need mkdir binary"],
  when_not: ["Prefer matrix mkdir", "Not in default enabled.json5; enable only after Policy review"],
  tags: ["unix", "fs", "dangerous"],
  outcome: "Usage: mkdir d | Sample: ",
  sample_usage: "mkdir d",
  sample_output: "",
  argv: ["./scripts/tools/unix-exec.sh", "/bin/mkdir"],
  timeout_sec: 15,
  max_output_bytes: 32768,
  pass_args: "env",
  parameters: {"type": "object", "properties": {"argv": {"type": "array", "items": {"type": "string"}, "description": "Extra argv after the binary. Relative paths only; no ..; simple -x/--long flags."}}},
}
