{
  name: "unix_nohup",
  description: "Run immune to hangups.",
  when: ["Rare backgrounding"],
  when_not: ["Writes nohup.out", "Not in default enabled.json5; enable only after Policy review"],
  tags: ["unix", "process", "dangerous"],
  outcome: "Usage: nohup ... | Sample: ",
  sample_usage: "nohup ...",
  sample_output: "",
  argv: ["./scripts/tools/unix-exec.sh", "/usr/bin/nohup"],
  timeout_sec: 15,
  max_output_bytes: 32768,
  pass_args: "env",
  parameters: {"type": "object", "properties": {"argv": {"type": "array", "items": {"type": "string"}, "description": "Extra argv after the binary. Relative paths only; no ..; simple -x/--long flags."}}},
}
