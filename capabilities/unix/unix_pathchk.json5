{
  name: "unix_pathchk",
  description: "Check pathnames for portability.",
  when: ["Need pathchk"],
  when_not: ["Rare"],
  tags: ["unix", "fs", "safeish"],
  outcome: "Usage: pathchk name | Sample: ",
  sample_usage: "pathchk name",
  sample_output: "",
  argv: ["./scripts/tools/unix-exec.sh", "/usr/bin/pathchk"],
  timeout_sec: 10,
  max_output_bytes: 65536,
  pass_args: "env",
  parameters: {"type": "object", "properties": {"argv": {"type": "array", "items": {"type": "string"}, "description": "Extra argv after the binary. Relative paths only; no ..; simple -x/--long flags."}}},
}
