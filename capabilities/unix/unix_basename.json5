{
  name: "unix_basename",
  description: "Strip directory from a path.",
  when: ["Need final path component"],
  when_not: ["Does not resolve symlinks"],
  tags: ["unix", "fs", "safeish"],
  outcome: "Usage: basename a/b/c | Sample: c",
  sample_usage: "basename a/b/c",
  sample_output: "c",
  argv: ["./scripts/tools/unix-exec.sh", "/usr/bin/basename"],
  timeout_sec: 10,
  max_output_bytes: 65536,
  pass_args: "env",
  parameters: {"type": "object", "properties": {"argv": {"type": "array", "items": {"type": "string"}, "description": "Extra argv after the binary. Relative paths only; no ..; simple -x/--long flags."}}},
}
