{
  name: "unix_hostname",
  description: "Print the system hostname.",
  when: ["Need machine hostname"],
  when_not: ["Do not use for DNS lookups"],
  tags: ["unix", "system", "safeish"],
  outcome: "Usage: hostname | Sample: host.local",
  sample_usage: "hostname",
  sample_output: "host.local",
  argv: ["/bin/hostname"],
  timeout_sec: 10,
  max_output_bytes: 65536,
  pass_args: "env",
  parameters: {"type": "object", "properties": {}},
}
