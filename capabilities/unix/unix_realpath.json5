{
  name: "unix_realpath",
  description: "Resolve a relative path to absolute.",
  when: ["Need canonical path"],
  when_not: ["OS realpath rules"],
  tags: ["unix", "fs", "safeish"],
  outcome: "Usage: realpath . | Sample: /abs/path",
  sample_usage: "realpath .",
  sample_output: "/abs/path",
  argv: ["./scripts/tools/unix-exec.sh", "/bin/realpath"],
  timeout_sec: 10,
  max_output_bytes: 65536,
  pass_args: "env",
  parameters: {"type": "object", "properties": {"argv": {"type": "array", "items": {"type": "string"}, "description": "Extra argv after the binary. Relative paths only; no ..; simple -x/--long flags."}}},
}
