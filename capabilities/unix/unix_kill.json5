{
  name: "unix_kill",
  description: "Send a signal to a process.",
  when: ["Need to signal PIDs"],
  when_not: ["Dangerous", "Not in default enabled.json5; enable only after Policy review"],
  tags: ["unix", "process", "dangerous"],
  outcome: "Usage: kill -0 PID | Sample: ",
  sample_usage: "kill -0 PID",
  sample_output: "",
  argv: ["./scripts/tools/unix-exec.sh", "/bin/kill"],
  timeout_sec: 15,
  max_output_bytes: 32768,
  pass_args: "env",
  parameters: {"type": "object", "properties": {"argv": {"type": "array", "items": {"type": "string"}, "description": "Extra argv after the binary. Relative paths only; no ..; simple -x/--long flags."}}},
}
