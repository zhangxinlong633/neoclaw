{
  name: "unix_false",
  description: "Exit with failure status and no output.",
  when: ["Need a failing probe for tests"],
  when_not: ["Do not use for real work"],
  tags: ["unix", "system", "safeish"],
  outcome: "Usage: false | Sample: (empty; exit 1)",
  sample_usage: "false",
  sample_output: "(empty; exit 1)",
  argv: ["/usr/bin/false"],
  timeout_sec: 10,
  max_output_bytes: 65536,
  pass_args: "env",
  parameters: {"type": "object", "properties": {}},
}
