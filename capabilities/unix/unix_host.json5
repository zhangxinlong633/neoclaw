{
  name: "unix_host",
  description: "Simple DNS lookup.",
  when: ["Need A/AAAA lookup"],
  when_not: ["Network dependency", "Not in default enabled.json5; enable only after Policy review"],
  tags: ["unix", "net", "dangerous"],
  outcome: "Usage: host example.com | Sample: has address ...",
  sample_usage: "host example.com",
  sample_output: "has address ...",
  argv: ["./scripts/tools/unix-exec.sh", "/usr/bin/host"],
  timeout_sec: 15,
  max_output_bytes: 32768,
  pass_args: "env",
  parameters: {"type": "object", "properties": {"argv": {"type": "array", "items": {"type": "string"}, "description": "Extra argv after the binary. Relative paths only; no ..; simple -x/--long flags."}}},
}
