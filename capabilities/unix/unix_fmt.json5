{
  name: "unix_fmt",
  description: "Simple text formatter.",
  when: ["Need wrapped paragraphs"],
  when_not: ["Not Markdown-aware"],
  tags: ["unix", "text", "safeish"],
  outcome: "Usage: fmt -w 72 notes.txt | Sample: wrapped",
  sample_usage: "fmt -w 72 notes.txt",
  sample_output: "wrapped",
  argv: ["./scripts/tools/unix-exec.sh", "/usr/bin/fmt"],
  timeout_sec: 10,
  max_output_bytes: 65536,
  pass_args: "env",
  parameters: {"type": "object", "properties": {"argv": {"type": "array", "items": {"type": "string"}, "description": "Extra argv after the binary. Relative paths only; no ..; simple -x/--long flags."}}},
}
