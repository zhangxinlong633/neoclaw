{
  name: "unix_look",
  description: "Display lines beginning with a string.",
  when: ["Need dictionary lookup"],
  when_not: ["Needs sorted file"],
  tags: ["unix", "text", "safeish"],
  outcome: "Usage: look pre file | Sample: ...",
  sample_usage: "look pre file",
  sample_output: "...",
  argv: ["./scripts/tools/unix-exec.sh", "/usr/bin/look"],
  timeout_sec: 10,
  max_output_bytes: 65536,
  pass_args: "env",
  parameters: {"type": "object", "properties": {"argv": {"type": "array", "items": {"type": "string"}, "description": "Extra argv after the binary. Relative paths only; no ..; simple -x/--long flags."}}},
}
