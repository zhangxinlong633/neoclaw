{
  name: "unix_test",
  description: "Evaluate conditional expressions.",
  when: ["Need shell-like tests"],
  when_not: ["Prefer DAG/LLM logic"],
  tags: ["unix", "util", "safeish"],
  outcome: "Usage: test -f README.md | Sample: (exit 0)",
  sample_usage: "test -f README.md",
  sample_output: "(exit 0)",
  argv: ["./scripts/tools/unix-exec.sh", "/bin/test"],
  timeout_sec: 10,
  max_output_bytes: 65536,
  pass_args: "env",
  parameters: {"type": "object", "properties": {"argv": {"type": "array", "items": {"type": "string"}, "description": "Extra argv after the binary. Relative paths only; no ..; simple -x/--long flags."}}},
}
